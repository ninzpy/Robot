{
  "name": "weblox",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // These paths go to the Worker first; everything else is static.
    "run_worker_first": ["/", "/wisp/*", "/blox/engine/*"]
  }
  // Optional: pin the Roblox engine version instead of following the latest.
  // "vars": { "ENGINE_VERSION": "version-0123456789abcdef" }
}
